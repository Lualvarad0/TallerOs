<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Este proyecto usa el Sdk normal (no Sdk.Web): WebApplicationFactory<Program> (pruebas de
       integración por HTTP real, ver EndpointsClientesYVehiculosTests) necesita esta referencia al
       framework compartido, y ReadFromJsonAsync/PostAsJsonAsync (Microsoft.AspNetCore.Http) la
       necesitan igual. Microsoft.AspNetCore.Mvc.Testing de abajo trae TestHost transitivamente. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TallerOS.Api\TallerOS.Api.csproj" />
  </ItemGroup>

</Project>