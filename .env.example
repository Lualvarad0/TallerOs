# Copiar a .env y llenar con valores reales. .env nunca se commitea.

# --- PostgreSQL ---
# POSTGRES_USER/PASSWORD son el superusuario que crea el propio contenedor;
# la API y las migraciones NUNCA se conectan con este usuario.
POSTGRES_DB=talleros
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-superuser

# Rol dueño del esquema, usado solo por `dotnet ef database update`.
TALLEROS_MIGRATOR_USER=talleros_migrator
TALLEROS_MIGRATOR_PASSWORD=changeme-migrator

# Rol con el que corre la API (sin DDL, sin BYPASSRLS).
TALLEROS_APP_USER=talleros_app
TALLEROS_APP_PASSWORD=changeme-app

# --- Redis ---
REDIS_PASSWORD=changeme-redis

# --- Garage (S3 local, reemplaza a MinIO: ver docs/especificacion.md) ---
GARAGE_RPC_SECRET=changeme-generar-con-openssl-rand-hex-32
GARAGE_S3_ACCESS_KEY=changeme-access-key
GARAGE_S3_SECRET_KEY=changeme-secret-key

# --- Cadenas de conexión que usará el backend (paso 3) ---
ConnectionStrings__App=Host=localhost;Port=5432;Database=talleros;Username=talleros_app;Password=changeme-app
ConnectionStrings__Migrator=Host=localhost;Port=5432;Database=talleros;Username=talleros_migrator;Password=changeme-migrator

# Clave simétrica para firmar JWT (generar con: openssl rand -base64 48). Nunca reusar el valor de ejemplo.
Jwt__Secret=changeme-generar-con-openssl-rand-base64-48
S3__Endpoint=http://localhost:3900
S3__Bucket=talleros
